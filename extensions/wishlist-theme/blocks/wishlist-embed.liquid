{% comment %}
  Wishlist app embed block.
  Enable in: Online Store > Themes > Customize > App embeds > Wishlist
{% endcomment %}

{%- assign wl_proxy_subpath = block.settings.proxy_subpath | default: "" -%}
{%- if wl_proxy_subpath == blank -%}
  {%- if shop.permanent_domain == "decorenllc.myshopify.com" -%}
    {%- assign wl_proxy_subpath = "wishlist-1" -%}
  {%- else -%}
    {%- assign wl_proxy_subpath = "wishlist" -%}
  {%- endif -%}
{%- endif -%}

<script>
  window.__wishlistConfig = {
    shop: {{ shop.permanent_domain | json }},
    currency: {{ cart.currency.iso_code | json }},
    customerId: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
    apiBase: "/apps/{{ wl_proxy_subpath }}/api",
    rootUrl: {{ routes.root_url | json }}
  };
</script>

<link rel="stylesheet" href="{{ 'wishlist.css' | asset_url }}">
<script src="{{ 'wishlist.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wishlist",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Wishlist is active. Configure colors, icon size, and page text in the app admin under Apps → custom wishlist app1."
    },
    {
      "type": "text",
      "id": "proxy_subpath",
      "label": "App Proxy Subpath",
      "info": "Leave blank for automatic detection ('wishlist' on dev, 'wishlist-1' on live store)."
    }
  ]
}
{% endschema %}